Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data1", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Insert", "[", 
      RowBox[{
       RowBox[{"AngleVector", "[", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "8"}], "}"}], "*", 
          RowBox[{"RandomReal", "[", "]"}]}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", "]"}], ",", "2"}], "]"}], ",", "500"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"isomapmodel", "=", 
   RowBox[{"DimensionReduction", "[", 
    RowBox[{"data1", ",", "2", ",", 
     RowBox[{"Method", "->", " ", "\"\<Isomap\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"isomappts", "=", 
   RowBox[{"isomapmodel", "[", "data1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Style", "[", 
      RowBox[{"#", ",", 
       RowBox[{"Hue", "[", 
        RowBox[{
         RowBox[{"First", "[", "#", "]"}], "/", "20"}], "]"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", "isomappts"}], ",", " ", 
   RowBox[{"AspectRatio", "\[Rule]", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"PointSize", "\[Rule]", "Medium"}], "]"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
