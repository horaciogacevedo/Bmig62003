Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"powerf", "[", 
    RowBox[{"x_", ",", "n_", ",", "\[Mu]_", ",", "\[Sigma]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"NProbability", "[", 
          RowBox[{
           RowBox[{"y", "<=", "x"}], " ", ",", 
           RowBox[{"Distributed", "[", 
            RowBox[{"y", ",", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}]}], "]"}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Times", "@@", "a"}]}]}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
