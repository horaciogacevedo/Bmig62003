 RowBox[{
  RowBox[{"prelassoc", "=", 
   RowBox[{"KeyMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<Data\>\"", "]"}], "&"}], ",", "temperatures"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myextract", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
